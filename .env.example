# MantisFetch configuration template.
#
# MINIMUM CONFIG: copy this file to `.env` (git-ignored) and fill in
# GEMINI_API_KEY in §1.1. Everything else has a working default — except under
# compose, where reaching /web and /doc from the host also needs
# MANTISFETCH_MCP_TOKEN (§2.1); see the note there for why.
#
# LAYOUT: one section per integration. Inside a section, credentials come first
# (what you must supply), then parameters (what you may tune).
#
# HOW THIS FILE IS READ: `docker compose` interpolates these values into the
# container's environment. The application itself does NOT read .env — for a
# bare-metal run (`python mantisfetch_server.py`) export the variables instead.
# Keys tagged [compose: no] are not forwarded by the bundled docker-compose.yml,
# so under compose they take effect only if you add them to it.
#
# Defaults are shown after each key. Full reference: README.md "Environment variables".


# ╔═══ 1. LLM — document summaries and OCR of scanned pages ═══════════════════╗

# ─── 1.1 Credentials — configure ONE of A / B / C ───────────────────────────

# A. Gemini (default)
MANTISFETCH_LLM_PROVIDER=gemini
GEMINI_API_KEY=
# GOOGLE_API_KEY=                  # accepted in place of GEMINI_API_KEY

# B. OpenAI-compatible — comment out the two live lines in A before enabling
# MANTISFETCH_LLM_PROVIDER=openai
# MANTISFETCH_LLM_VENDOR=openai    # openai | zhipu | kimi | aliyun | volcengine
# MANTISFETCH_LLM_API_KEY=
# MANTISFETCH_LLM_BASE_URL=        # default: the vendor profile's URL

# C. Two credential slots — needed only to run different roles on different
# vendors (see 1.2 "per-role"). Setting MANTISFETCH_LLM_DEFAULT switches this
# scheme on and supersedes A/B. Each slot carries a vendor tag + endpoint + key;
# a Gemini slot uses google-genai and ignores its _BASE_URL.
# MANTISFETCH_LLM_DEFAULT=zhipu
# MANTISFETCH_LLM_DEFAULT_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# MANTISFETCH_LLM_DEFAULT_API_KEY=
# MANTISFETCH_LLM_EXTRA=deepseek
# MANTISFETCH_LLM_EXTRA_BASE_URL=https://api.deepseek.com/v1
# MANTISFETCH_LLM_EXTRA_API_KEY=

# ─── 1.2 Models ─────────────────────────────────────────────────────────────
# Two ways to name models — by kind, or by role. Pick one; if both are set, the
# per-role keys win. By-kind goes with credential schemes A and B and is optional
# there (both have a working default). Scheme C is per-role only: a bare model
# name cannot say which of the two slots it belongs to, so the by-kind keys are
# ignored and the two *_MODEL_DEFAULT keys below become REQUIRED.

# By kind — credential schemes A and B. One model for everything, or split
# text vs OCR:
# MANTISFETCH_LLM_MODEL=           # text (and OCR, unless the next key is set).
#                                  # Default: gemini-2.5-flash on A, the vendor profile's on B
# MANTISFETCH_OCR_MODEL=           # OCR only; default: MANTISFETCH_LLM_MODEL

# By role — required by credential scheme C. Each role takes a primary and an
# optional fallback, both written "<vendor>/<model>"; the prefix routes the call
# to the slot whose tag matches, so a role can sit on either vendor and fail over
# to the other.
# MANTISFETCH_SUM_MODEL_DEFAULT=deepseek/deepseek-chat   # required with scheme C
# MANTISFETCH_SUM_MODEL_FALLBACK=zhipu/glm-4.6
# MANTISFETCH_OCR_MODEL_DEFAULT=zhipu/glm-4.6v            # required with scheme C
# MANTISFETCH_OCR_MODEL_FALLBACK=deepseek/deepseek-chat


# ╔═══ 2. Access control — /web, /doc and /mcp ════════════════════════════════╗

# ─── 2.1 Credentials ────────────────────────────────────────────────────────
# Without a token these surfaces serve loopback peers only — and compose
# publishes port 9898, so a request from the host arrives over the Docker bridge
# (a non-loopback peer) and is refused. Set this to use the container.
# MANTISFETCH_MCP_TOKEN=

# ─── 2.2 Parameters ─────────────────────────────────────────────────────────
# MANTISFETCH_MCP_ALLOWED_HOSTS=   # extra Host values past the rebinding check; "host:*" = any port
# MANTISFETCH_TLS_CERTFILE=/certs/cert.pem   # both TLS keys unset = plain http
# MANTISFETCH_TLS_KEYFILE=/certs/key.pem


# ╔═══ 3. Web search — disabled unless MANTISFETCH_SEARCH_PROVIDER is set ═════╗
# With no provider set, /web/search* return 404 and the MCP search tools are not
# registered.

# ─── 3.1 Credentials ────────────────────────────────────────────────────────
# MANTISFETCH_SEARCH_API_KEY=      # shared key for tavily / bocha / brave
# MANTISFETCH_TAVILY_API_KEY=      # a per-provider key wins over the shared one — set
# MANTISFETCH_BOCHA_API_KEY=       # these to run more than one API provider at once
# MANTISFETCH_BRAVE_API_KEY=
# MANTISFETCH_SEARXNG_URL=         # instance URL; required by the searxng provider

# ─── 3.2 Parameters ─────────────────────────────────────────────────────────
# MANTISFETCH_SEARCH_PROVIDER=     # searxng | tavily | bocha | brave — the master switch
# MANTISFETCH_SEARCH_FALLBACK=     # comma-separated; tried ONLY on connection error / 5xx / timeout
# MANTISFETCH_SEARCH_PROVIDERS=bocha,tavily   # addressable set for per-call `provider` selection
# MANTISFETCH_SEARCH_MAX_RESULTS=10
# MANTISFETCH_SEARCH_MIN_INTERVAL_SEC=2


# ╔═══ 4. Storage ════════════════════════════════════════════════════════════╗
# MANTISFETCH_HOST_DOCS_DIR=       # HOST path bind-mounted as the library (default: ~/.mantisfetch/docs)
# MANTISFETCH_DOCS_DIR=            # library path as the PROCESS sees it (default: ~/.mantisfetch/docs);
#                                  # under compose it is fixed to /root/.mantisfetch/docs, so move the
#                                  # library with MANTISFETCH_HOST_DOCS_DIR above, not with this key.
# MANTISFETCH_STORE_SOURCE_FILES=true    # keep the uploaded original beside the parse  [compose: no]
# MANTISFETCH_ALLOWED_DOC_ROOTS=   # fence for doc_parse's local-path source; unset = local paths refused  [compose: no]


# ╔═══ 5. Deliverables — GET /deliverables, disabled unless the root is set ═══╗
# Read-only byte face for agent deliverables. Unset = every request 404s. The
# root must not overlap MANTISFETCH_DOCS_DIR or MANTISFETCH_ALLOWED_DOC_ROOTS.
# MANTISFETCH_DELIVERABLES_ROOT=          # [compose: no]
# MANTISFETCH_DELIVERABLES_MAX_MB=200     # 413 above this  [compose: no]


# ╔═══ 6. Web capture cache ══════════════════════════════════════════════════╗
# MANTISFETCH_NEGOTIATE_MARKDOWN=0        # ask the site for markdown before opening a
#                                        # browser (Accept: text/markdown, .md path,
#                                        # llms.txt). Off: llms.txt adoption is thin and
#                                        # a negotiated capture has no tables.
#                                        # NOTE: the request must also pass
#                                        # extract_tables=false — it defaults to true, and
#                                        # this flag alone changes nothing.
# MANTISFETCH_NEGOTIATE_CONCURRENCY=20     # in-flight negotiation fetches
# MANTISFETCH_CAPTURE_TTL_HOURS=0          # URL-level reuse for /web/capture; 0 = off
# MANTISFETCH_SEARCH_CAPTURE_TTL_HOURS=24  # URL-level reuse for /web/search_and_capture
# Content-hash reuse runs library-wide after distill for both endpoints anyway,
# unless the request passes force_refresh.


# ╔═══ 7. Tuning — sane defaults; change under measured pressure ═════════════╗
# MANTISFETCH_SUMMARY_MODE=        # off | sync | defer; unset = the parse profile decides  [compose: no]
# MANTISFETCH_MAX_CONCURRENT_PARSE=2
# MANTISFETCH_LOCAL_OCR_CONCURRENCY=1
# MANTISFETCH_DEFERRED_SUMMARY_MAX_CONCURRENT=1
# LANG=en                          # en | zh, for logs and error messages  [compose: no]
#
# Around fifty further knobs exist (OCR engine selection, upload/size caps,
# timeouts, session limits). They are deliberately not listed here — see
# README.md "Environment variables".
